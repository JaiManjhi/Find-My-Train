# Copy this file to .env and fill in your own API keys.
# Never commit the real .env file — it's gitignored.
#
# If a key is left blank, that provider's calls will fail and the
# corresponding endpoint gracefully falls back to mock/static data.

# https://railradar.in/ — sign up for API access
RAILRADAR_API_KEY=

# https://openweathermap.org/api — free tier available
OPENWEATHER_API_KEY=

# https://opentopography.org/ — free registration
OPENTOPOGRAPHY_API_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
