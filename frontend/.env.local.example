# Copy this file to .env.local and fill in your own values.
# NEXT_PUBLIC_* vars are exposed to the browser bundle by design — never put
# non-public secrets here.

# Base URL of the running backend (see ../backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# https://cloud.maptiler.com/ — free tier available, used for station geocoding
NEXT_PUBLIC_MAPTILER_API_KEY=
